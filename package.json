{
  "name": "ukhuwah-mart-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi kasir desktop offline untuk UMKM",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron-builder install-app-deps && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron-builder install-app-deps && electron .",
    "test": "npm rebuild better-sqlite3 && node --test",
    "dist:win:dir": "npm run build && electron-builder --win dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "better-sqlite3": "^11.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ukhuwahmart.pos",
    "productName": "Ukhuwah Mart POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
